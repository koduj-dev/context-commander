class Ccd < Formula
  desc "Shared context and collaboration layer for humans and AI agents"
  homepage "https://github.com/koduj-dev/context-commander"
  version "__VERSION__"
  license "AGPL-3.0-only"

  on_macos do
    on_intel do
      url "https://github.com/koduj-dev/context-commander/releases/download/v__VERSION__/ccd-darwin-amd64"
      sha256 "__SHA_DARWIN_AMD64__"
    end
    on_arm do
      url "https://github.com/koduj-dev/context-commander/releases/download/v__VERSION__/ccd-darwin-arm64"
      sha256 "__SHA_DARWIN_ARM64__"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/koduj-dev/context-commander/releases/download/v__VERSION__/ccd-linux-amd64"
      sha256 "__SHA_LINUX_AMD64__"
    end
    on_arm do
      url "https://github.com/koduj-dev/context-commander/releases/download/v__VERSION__/ccd-linux-arm64"
      sha256 "__SHA_LINUX_ARM64__"
    end
  end

  def install
    # The release asset is the bare binary (ccd-<os>-<arch>); only one is
    # downloaded per platform, so install it under the canonical name.
    bin.install Dir["ccd-*"].first => "ccd"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/ccd version")
  end
end
