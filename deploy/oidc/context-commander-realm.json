        "http://localhost:5173/v1/auth/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:12001",
        "http://127.0.0.1:12001"
      ],
      "defaultClientScopes": [
        "openid",
        "profile"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:12001/*"
      },
      "optionalClientScopes": [
        "email"
      ]
    }
