# Context Commander server settings — read by systemd for ccd.service.
# Fill in the three required values, then: sudo systemctl start ccd
# Full list: `ccd serve --help` (every flag has a CC_* variable where noted)
# and docs/install.md.

# Required. The runtime role — cc_app, never the schema owner (docs/adr/0002).
#CC_DATABASE_URL=postgres://cc_app:CHANGE_ME@127.0.0.1:5432/context_commander?sslmode=disable

# Required. Encrypts every project key and through them all content
# (docs/adr/0005). Generate with `openssl rand -base64 32`. It cannot be
# recovered: back it up somewhere other than this machine before writing
# anything — losing it loses the data.
#CC_ROOT_KEY=

# Where artifact and skill bytes live. Back it up together with the database.
#CC_STORAGE_DIR=/var/lib/ccd/objects

# Optional: a default storage limit per user/organization (ADR 0021).
#CC_STORAGE_QUOTA=10GB

# Optional: a price table per model, to show what reported tokens would cost
# on the API as an estimate (ADR 0022). Start from the example in the source
# tree, deploy/usage-prices.example.json, and check its prices first.
#CC_USAGE_PRICES=/etc/context-commander/usage-prices.json

# Optional: sign-in through OpenID Connect or LDAP — see `ccd serve --help`
# for the remaining --oidc-* / --ldap-* flags (add them with `systemctl edit ccd`).
#CC_OIDC_ISSUER=
#CC_OIDC_CLIENT_SECRET=
#CC_LDAP_URL=
#CC_LDAP_BIND_PASSWORD=
